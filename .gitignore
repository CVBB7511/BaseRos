# ====== Root Workspace Rules ======
# Rules for /src are maintained by /src/.gitignore.
# Keep /src-specific patterns out of this file so Git can apply that nested file.

# ====== IDE & Editor ======
/.idea/
/.vscode/
/*.swp
/*.swo
/*~
/.DS_Store

# ====== Python ======
/__pycache__/
/*.py[cod]
/*.egg-info/
/*.egg
/build/
/dist/

# ====== Conda ======
/.python-version
/environment.yml

# ====== System & Logs ======
/*.log
/*.ros_log*
/*.pcd
/.ros/

# ====== Archives & Backups ======
/*.tar.gz
/*.zip
/*.bak
/*.backup

# ====== Claude ======
/.claude/settings.local.json
