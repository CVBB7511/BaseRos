<launch>
    <!-- ============================================ -->
    <!-- Palletizing 执行阶段 — 真机版                  -->
    <!-- 使用已保存的地图 + AMCL 定位 + 码垛执行器      -->
    <!--                                               -->
    <!-- 与仿真版的区别:                                 -->
    <!--   - 不含 Gazebo (world / spawn_model)          -->
    <!--   - 使用真实硬件驱动 (wpb_home_core)            -->
    <!--   - 不含 use_sim_time                           -->
    <!--                                               -->
    <!-- 前提条件:                                      -->
    <!--   - 已完成建图并保存地图                         -->
    <!--                                               -->
    <!-- 使用方法:                                      -->
    <!--   1. roslaunch gazebosim_demo palletizing_execute_real.launch \  -->
    <!--        map_file:=/path/to/your_map.yaml                          -->
    <!--   2. 在 RViz 中设置机器人初始位置 (2D Pose Estimate)             -->
    <!--   3. 标定桌面位置 (可选):                                        -->
    <!--      rosrun palletizing mark_table_positions.py                  -->
    <!--   4. 触发码垛: rosservice call /palletizing/start "{}"           -->
    <!--                                               -->
    <!-- 命令行传参示例:                                 -->
    <!--   roslaunch gazebosim_demo palletizing_execute_real.launch \    -->
    <!--     map_file:=/home/robot/maps/workshop.yaml \                  -->
    <!--     source_table_x:=-2.0 source_table_y:=0.5 source_table_yaw:=1.57 \ -->
    <!--     dest_table_x:=2.0 dest_table_y:=-0.3 dest_table_yaw:=0.0    -->
    <!-- ============================================ -->

    <!-- ===== Map file path ===== -->
    <arg name="map_file" default="$(find gazebosim_demo)/maps/palletizing_map.yaml"/>

    <!-- ===== Table Configuration (可命令行传参) ===== -->
    <arg name="source_table_x" default="-1.5"/>
    <arg name="source_table_y" default="0.0"/>
    <arg name="source_table_z" default="0.75"/>
    <arg name="source_table_yaw" default="0.0"/>
    <arg name="source_table_length" default="1.0"/>
    <arg name="source_table_width" default="0.5"/>
    <arg name="dest_table_x" default="1.5"/>
    <arg name="dest_table_y" default="0.0"/>
    <arg name="dest_table_z" default="0.75"/>
    <arg name="dest_table_yaw" default="3.1416"/>
    <arg name="dest_table_length" default="1.0"/>
    <arg name="dest_table_width" default="0.5"/>

    <!-- ===== 机器人 URDF 模型 ===== -->
    <arg name="model" default="$(find wpb_home_bringup)/urdf/wpb_home.urdf"/>
    <param name="robot_description" command="$(find xacro)/xacro $(arg model)" />
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />

    <!-- ===== 机器人底盘 + 机械臂驱动 (真机核心) ===== -->
    <node pkg="wpb_home_bringup" type="wpb_home_core" name="wpb_home_core" output="screen">
        <param name="serial_port" type="string" value="/dev/ftdi"/>
        <rosparam file="$(find wpb_home_bringup)/config/wpb_home.yaml" command="load" />
    </node>

    <!-- ===== RPLIDAR 激光雷达 ===== -->
    <node name="rplidarNode" pkg="rplidar_ros" type="rplidarNode" output="screen">
        <param name="serial_port"     type="string" value="/dev/rplidar"/>
        <param name="serial_baudrate" type="int"    value="115200"/>
        <param name="frame_id"        type="string" value="laser"/>
        <param name="inverted"        type="bool"   value="false"/>
        <param name="angle_compensate" type="bool"  value="true"/>
        <remap from="scan" to="scan_raw"/>
    </node>
    <node pkg="wpb_home_bringup" type="wpb_home_lidar_filter" name="wpb_home_lidar_filter">
        <param name="pub_topic" value="/scan"/>
    </node>

    <!-- ===== Kinect2 RGB-D 相机 ===== -->
    <include file="$(find kinect2_bridge)/launch/kinect2_bridge.launch" />

    <!-- ===== Behavior nodes (grab / place / object detect) ===== -->
    <node pkg="wpb_home_behaviors" type="wpb_home_objects_3d" name="wpb_home_objects_3d" output="screen">
        <param name="topic" type="string" value="/kinect2/sd/points" />
        <param name="start" type="bool" value="false" />
        <param name="filter_cube_size" type="bool" value="true" />
        <param name="cube_size_small" type="double" value="0.10" />
        <param name="cube_size_large" type="double" value="0.15" />
        <param name="cube_size_tolerance" type="double" value="0.07" />
        <param name="cube_min_x_size" type="double" value="0.03" />
        <param name="cube_max_x_size" type="double" value="0.35" />
        <param name="cube_shape_ratio" type="double" value="2.3" />
        <param name="cube_prism_bottom_cut" type="double" value="0.03" />
        <param name="cluster_tolerance" type="double" value="0.04" />
        <param name="cluster_min_size" type="int" value="500" />
        <param name="cluster_max_size" type="int" value="10000000" />
    </node>
    <node pkg="wpb_home_behaviors" type="wpb_home_grab_action" name="wpb_home_grab_action">
        <rosparam file="$(find wpb_home_bringup)/config/wpb_home.yaml" command="load" />
        <param name="grab/grab_y_offset" type="double" value="-0.07" />
        <param name="grab/grab_lift_offset" type="double" value="0.03" />
        <param name="grab/grab_forward_offset" type="double" value="0.0" />
        <param name="grab/grab_align_timeout" type="double" value="15.0" />
        <param name="grab/grab_hand_up_wait" type="double" value="15.0" />
    </node>
    <node pkg="wpb_home_behaviors" type="wpb_home_place_action" name="wpb_home_place_action">
        <param name="place_lift_clearance" type="double" value="0.01" />
        <param name="place_hand_up_wait" type="double" value="15.0" />
        <param name="place_release_wait" type="double" value="1.0" />
    </node>

    <!-- ===== Map Server ===== -->
    <node name="map_server" pkg="map_server" type="map_server"
        args="$(arg map_file)" />

    <!-- ===== AMCL Localization ===== -->
    <include file="$(find wpb_home_tutorials)/nav_lidar/amcl_omni.launch" />

    <!-- ===== Navigation (move_base) ===== -->
    <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
        <rosparam ns="global_costmap">
            robot_radius: 0.25
            inflation_radius: 0.5
            obstacle_range: 6.0
            raytrace_range: 6.0
            observation_sources: base_lidar
            base_lidar: {data_type: LaserScan, topic: /scan, marking: true, clearing: true}
        </rosparam>
        <rosparam file="$(find navigation)/launch/wj_costmap_common_params.yaml" command="load"
            ns="local_costmap" />
        <rosparam file="$(find wpb_home_tutorials)/nav_lidar/local_costmap_params.yaml"
            command="load" />
        <rosparam file="$(find wpb_home_tutorials)/nav_lidar/global_costmap_params.yaml"
            command="load" />
        <param name="base_global_planner" value="global_planner/GlobalPlanner" />
        <param name="use_dijkstra" value="true" />
        <param name="base_local_planner" value="wpbh_local_planner/WpbhLocalPlanner" />
        <param name="controller_frequency" value="10" type="double" />
        <param name="xy_goal_tolerance" value="0.05" type="double" />
        <param name="yaw_goal_tolerance" value="0.05" type="double" />
        <param name="planner_frequency" value="0.5" type="double" />
        <param name="planner_patience" value="10.0" type="double" />
        <param name="WpbhLocalPlanner/max_vel_trans" value="0.24" type="double" />
        <param name="WpbhLocalPlanner/max_vel_rot" value="0.4" type="double" />
        <param name="WpbhLocalPlanner/acc_scale_trans" value="2.0" type="double" />
        <param name="WpbhLocalPlanner/acc_scale_rot" value="0.65" type="double" />
        <param name="WpbhLocalPlanner/goal_dist_tolerance" value="0.05" type="double" />
        <param name="WpbhLocalPlanner/goal_yaw_tolerance" value="0.05" type="double" />
    </node>

    <!-- ===== Palletizing Executor ===== -->
    <node pkg="palletizing" type="palletizing_executor.py" name="palletizing_executor" output="screen">
        <param name="source_table_x" type="double" value="$(arg source_table_x)"/>
        <param name="source_table_y" type="double" value="$(arg source_table_y)"/>
        <param name="source_table_z" type="double" value="$(arg source_table_z)"/>
        <param name="source_table_yaw" type="double" value="$(arg source_table_yaw)"/>
        <param name="source_table_length" type="double" value="$(arg source_table_length)"/>
        <param name="source_table_width" type="double" value="$(arg source_table_width)"/>
        <param name="dest_table_x" type="double" value="$(arg dest_table_x)"/>
        <param name="dest_table_y" type="double" value="$(arg dest_table_y)"/>
        <param name="dest_table_z" type="double" value="$(arg dest_table_z)"/>
        <param name="dest_table_yaw" type="double" value="$(arg dest_table_yaw)"/>
        <param name="dest_table_length" type="double" value="$(arg dest_table_length)"/>
        <param name="dest_table_width" type="double" value="$(arg dest_table_width)"/>
        <param name="grid_cols" type="int" value="2"/>
        <param name="grid_rows" type="int" value="3"/>
        <param name="cube_height" type="double" value="0.06"/>
        <param name="hard_cube_height" type="double" value="0.10"/>
        <param name="soft_cube_height" type="double" value="0.15"/>
        <param name="soft_place_offset" type="double" value="0.005"/>
        <param name="place_stack_clearance" type="double" value="0.0"/>
        <param name="stacking_pattern" type="string" value="aligned"/>
        <param name="spacing_x" type="double" value="0.18"/>
        <param name="spacing_y" type="double" value="0.17"/>
        <param name="zone_separation_y" type="double" value="0.35"/>
        <param name="nav_timeout" type="double" value="120.0"/>
        <param name="detect_timeout" type="double" value="5.0"/>
        <param name="detect_min_samples" type="int" value="3"/>
        <param name="detect_fusion_samples" type="int" value="5"/>
        <param name="detect_fusion_min_hits" type="int" value="2"/>
        <param name="detect_fusion_merge_xy" type="double" value="0.08"/>
        <param name="detect_retry_count" type="int" value="2"/>
        <param name="detect_retry_settle" type="double" value="0.50"/>
        <param name="detect_lift_height" type="double" value="0.0"/>
        <param name="detect_gripper_open" type="double" value="0.15"/>
        <param name="arm_reach_distance" type="double" value="0.50"/>
        <param name="arm_exit_margin" type="double" value="0.10"/>
        <param name="min_table_exit_back_distance" type="double" value="0.02"/>
        <param name="approach_offset" type="double" value="0.90"/>
        <param name="place_approach_offset" type="double" value="0.90"/>
        <param name="table_half_depth" type="double" value="0.25"/>
        <param name="gripper_hard_cube" type="double" value="0.032"/>
        <param name="gripper_soft_cube" type="double" value="0.078"/>
    </node>

    <!-- ===== RViz (navigation view) ===== -->
    <node pkg="rviz" type="rviz" name="rviz_nav"
        args="-d $(find gazebosim_demo)/rviz/nav.rviz" />

</launch>
