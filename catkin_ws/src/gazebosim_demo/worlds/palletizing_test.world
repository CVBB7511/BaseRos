<sdf version='1.6'>
    <world name='palletizing_test'>

        <!-- Scene -->
        <scene>
            <grid>false</grid>
        </scene>

        <!-- light -->
        <light name='sun' type='directional'>
            <cast_shadows>1</cast_shadows>
            <pose frame=''>0 0 10 0 -0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <attenuation>
                <range>10000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.5 -1</direction>
        </light>

        <!-- walls -->
        <include>
            <uri>model://walls/east_wall</uri>
        </include>
        <include>
            <uri>model://walls/west_wall</uri>
        </include>
        <include>
            <uri>model://walls/south_wall1</uri>
        </include>
        <include>
            <uri>model://walls/south_wall2</uri>
        </include>
        <include>
            <uri>model://walls/south_wall3</uri>
        </include>
        <include>
            <uri>model://walls/north_wall</uri>
        </include>

        <!-- ground plane -->
        <include>
            <uri>model://ground</uri>
            <name>ground_plane</name>
        </include>

        <!-- ===== Source table (源桌子): objects to pick from ===== -->
        <include>
            <name>source_table</name>
            <uri>model://table</uri>
            <pose>-1.5 0 0 0 0 0</pose>
        </include>

        <!-- ===== Dest table (目标桌子): place objects here ===== -->
        <include>
            <name>dest_table</name>
            <uri>model://table</uri>
            <pose>1.5 0 0 0 0 0</pose>
        </include>

        <!-- ===== Test objects on source table (桌面上 10cm/15cm 立方体) ===== -->
        <!-- Tabletop at z=0.765, cubes sit on top -->
        <!-- hard_cube: 10cm side, placed at z = 0.765 + 0.05 = 0.815 -->
        <include>
            <name>hard_cube_1</name>
            <uri>model://hard_cube</uri>
            <pose>-1.5 -0.2 0.815 0 0 0</pose>
        </include>
        <include>
            <name>hard_cube_2</name>
            <uri>model://hard_cube</uri>
            <pose>-1.3 0.0 0.815 0 0 0</pose>
        </include>
        <include>
            <name>hard_cube_3</name>
            <uri>model://hard_cube</uri>
            <pose>-1.5 0.2 0.815 0 0 0</pose>
        </include>

        <!-- soft_cube: 15cm side, placed at z = 0.765 + 0.075 = 0.84 -->
        <include>
            <name>soft_cube_1</name>
            <uri>model://soft_cube</uri>
            <pose>-1.7 0.0 0.84 0 0 0</pose>
        </include>
        <include>
            <name>soft_cube_2</name>
            <uri>model://soft_cube</uri>
            <pose>-1.4 -0.3 0.84 0 0 0</pose>
        </include>

    </world>
</sdf>
