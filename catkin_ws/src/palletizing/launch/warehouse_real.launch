<launch>
  <!-- ══════════════════════════════════════════════════════════
       码垛机器人 - 仓库实机运行 (Real World Run)
       
       说明：
       此 launch 文件用于在真实环境完全拉起码垛任务的所有节点。
       包括：底盘硬件、激光雷达、Kinect V2 相机、导航定位、和我们编写的所有业务节点。
       
       用法: 
         roslaunch palletizing warehouse_real.launch
  ══════════════════════════════════════════════════════════ -->

  <!-- ─── 加载实机全量参数 ─── -->
  <rosparam file="$(find palletizing)/config/palletizing_params_real.yaml" command="load" />

  <!-- ─── 1. 硬件驱动层 (底盘 + 机械臂) ─── -->
  <node pkg="wpb_home_bringup" type="wpb_home_core" name="wpb_home_core" output="screen">
    <param name="serial_port" type="string" value="/dev/ftdi"/> 
    <!-- 底盘自身出厂配置 -->
    <rosparam file="$(find wpb_home_bringup)/config/wpb_home.yaml" command="load" />
  </node>

  <!-- ─── 2. 传感器层 (雷达 + 深度相机) ─── -->
  <node name="rplidarNode" pkg="rplidar_ros" type="rplidarNode" output="screen">
    <param name="serial_port" type="string" value="/dev/rplidar"/>  
    <param name="serial_baudrate" type="int" value="115200"/>
    <param name="frame_id" type="string" value="laser"/>
    <param name="inverted" type="bool" value="false"/>
    <param name="angle_compensate" type="bool" value="true"/>
    <remap from="scan" to="scan_raw"/>
  </node>
  <node pkg="wpb_home_bringup" type="wpb_home_lidar_filter" name="wpb_home_lidar_filter">
    <param name="pub_topic" value="/scan"/>
  </node>
  <!-- 启动 Kinect V2 相机桥接节点，获取深度点云 -->
  <!-- depth_method/reg_method: 优先用 opengl，若显卡不可用改为 cpu -->
  <!-- 若仍失败，在机载电脑手动运行: roslaunch kinect2_bridge kinect2_bridge.launch depth_method:=cpu reg_method:=cpu -->
  <include file="$(find kinect2_bridge)/launch/kinect2_bridge.launch">
    <arg name="depth_method" value="cpu"/>
    <arg name="reg_method"   value="cpu"/>
    <arg name="fps_limit"    value="5.0"/>
  </include>

  <!-- kinect2_bridge 已通过 image_transport 自动发布 /compressed 子话题，
       GUI 直接订阅 bridge 原生的 compressed 话题即可，无需额外的 republish 中转节点。
       移除 republish 后，bridge 不再被迫为 QHD raw 彩色图持续编码 (~15MB/s)，
       仅当 GUI 订阅 compressed 话题时才触发轻量级 JPEG 编码。 -->


  <!-- ─── 3. URDF 与 TF 树 ─── -->
  <arg name="model" default="$(find wpb_home_bringup)/urdf/wpb_home_mani.urdf"/>
  <param name="robot_description" command="$(find xacro)/xacro $(arg model)" />
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>

  <!-- ─── 4. 导航层 (地图 + 定位 + 路径规划) ─── -->
  <node name="map_server" pkg="map_server" type="map_server"
        args="$(find palletizing)/maps/warehouse_real.yaml"/>
  <include file="$(find wpb_home_tutorials)/nav_lidar/amcl_omni.launch" />
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <rosparam file="$(find wpb_home_tutorials)/nav_lidar/costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find wpb_home_tutorials)/nav_lidar/costmap_common_params.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find wpb_home_tutorials)/nav_lidar/local_costmap_params.yaml" command="load" />
    <rosparam file="$(find wpb_home_tutorials)/nav_lidar/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find wpb_home_tutorials)/nav_lidar/local_planner_params.yaml" command="load" />
    <param name="base_global_planner" value="global_planner/GlobalPlanner" />
    <param name="base_local_planner" value="wpbh_local_planner/WpbhLocalPlanner" />
    <param name="controller_frequency" value="10" type="double"/>
  </node>

  <!-- ─── 5. 业务逻辑层 (码垛系统组件) ─── -->
  <!-- 所有业务节点统一放在 /palletizing 命名空间下，与 task_manager_node 中硬编码的话题路径保持一致 -->
  <group ns="palletizing">

    <!-- 视觉识别节点 -->
    <node pkg="palletizing" type="color_objects_3d" name="color_objects_3d" output="screen">
      <!-- 使用 kinect2 的 topic -->
      <param name="topic" type="string" value="/kinect2/sd/points"/>
    </node>

    <!-- 抓取和放置动作执行器 (C++ 节点)，挂载实机参数 -->
    <node pkg="palletizing" type="custom_grab_action" name="wpb_home_grab_action" output="screen">
      <rosparam file="$(find palletizing)/config/palletizing_params_real.yaml" command="load" />
    </node>
    <node pkg="palletizing" type="custom_place_action" name="wpb_home_place_action" output="screen">
      <rosparam file="$(find palletizing)/config/palletizing_params_real.yaml" command="load" />
    </node>

    <!-- 顶层任务节点群 (Python 节点)，均加载实机参数配置 -->
    <node pkg="palletizing" type="manipulator_server.py" name="manipulator_server" output="screen">
      <rosparam file="$(find palletizing)/config/palletizing_params_real.yaml" command="load" />
    </node>
    <node pkg="palletizing" type="navigation_server.py" name="navigation_server" output="screen">
      <rosparam file="$(find palletizing)/config/palletizing_params_real.yaml" command="load" />
    </node>
    <node pkg="palletizing" type="vision_service.py" name="vision_service" output="screen">
      <rosparam file="$(find palletizing)/config/palletizing_params_real.yaml" command="load" />
    </node>
    <node pkg="palletizing" type="task_manager_node.py" name="task_manager_node" output="screen">
      <rosparam file="$(find palletizing)/config/palletizing_params_real.yaml" command="load" />
    </node>

  </group>

</launch>
