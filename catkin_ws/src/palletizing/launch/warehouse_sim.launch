<launch>
  <!-- ══════════════════════════════════════════════════════════
       码垛机器人 - 仓库仿真 (导航模式)
       前置条件: 已完成建图 (palletizing/maps/warehouse.yaml)
       用法: roslaunch palletizing warehouse_sim.launch
  ══════════════════════════════════════════════════════════ -->

  <!-- ─── 1. Gazebo 仿真世界 ─── -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find palletizing)/worlds/warehouse.world"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="debug" value="false"/>
  </include>

  <!-- ─── 2. 生成机器人 ─── -->
  <node name="spawn_robot" pkg="gazebo_ros" type="spawn_model"
        args="-file $(find wpr_simulation)/models/wpb_home_mani.model
              -urdf -x 0 -y 0 -model wpb_home_mani" />

  <!-- ════════════════════════════════════════════
       3. 生成桌子
       仓库 8m(X) x 4m(Y), 桌子 1.2m(X) x 0.5m(Y) @ yaw=1.57
       桌子长边贴墙, 短边距侧墙留间距
       过道宽度 ~1.0m (< 桌子 1.2m)
  ════════════════════════════════════════════ -->
  <!-- 桌子A: 北墙右侧 -->
  <node name="table_a" pkg="gazebo_ros" type="spawn_model"
        args="-file $(find palletizing)/models/table.model
              -urdf -x 2.0 -y 1.75 -z 0 -Y 1.57 -model table_a" />
  <!-- 桌子B: 南墙左侧 -->
  <node name="table_b" pkg="gazebo_ros" type="spawn_model"
        args="-file $(find palletizing)/models/table.model
              -urdf -x -2.0 -y -1.75 -z 0 -Y 1.57 -model table_b" />
  <!-- 桌子C: 南墙右侧 -->
  <node name="table_c" pkg="gazebo_ros" type="spawn_model"
        args="-file $(find palletizing)/models/table.model
              -urdf -x 2.0 -y -1.75 -z 0 -Y 1.57 -model table_c" />

  <!-- ════════════════════════════════════════════
       4. 自动生成积木 (由 YAML 配置驱动)
  ════════════════════════════════════════════ -->
  <rosparam file="$(find palletizing)/config/palletizing_params.yaml" command="load" />
  <node name="block_spawner" pkg="palletizing" type="spawn_blocks.py" output="screen" />

  <!-- ─── 5. 机器人控制器 + 传感器 ─── -->
  <include file="$(find wpr_simulation)/launch/wpb_home_controllers.launch"/>
  <node pkg="wpr_simulation" type="lidar_filter" name="lidar_filter" />

  <!-- ─── 6. 厂家行为节点与我们的自定义视觉节点 ─── -->
  <node pkg="palletizing" type="color_objects_3d"
        name="color_objects_3d" output="screen">
    <param name="topic" type="string" value="/kinect2/sd/points"/>
  </node>
  <node pkg="palletizing" type="custom_grab_action"
        name="wpb_home_grab_action">
    <rosparam file="$(find palletizing)/config/palletizing_params.yaml" command="load" />
    <rosparam file="$(find wpb_home_bringup)/config/wpb_home.yaml" command="load" />
    <!-- 对齐 10cm 方块：夹爪间距 0.08m；lift_offset 补偿升降轴与夹爪物理中心的机械偏差 -->
    <param name="grab/grab_gripper_value" value="0.08" />
    <param name="grab/grab_lift_offset" value="-0.03" />
  </node>
  <node pkg="palletizing" type="custom_place_action"
        name="wpb_home_place_action">
    <rosparam file="$(find palletizing)/config/palletizing_params.yaml" command="load" />
  </node>

  <!-- ─── 7. URDF + TF ─── -->
  <arg name="model" default="$(find wpb_home_bringup)/urdf/wpb_home_mani.urdf"/>
  <param name="robot_description" command="$(find xacro)/xacro $(arg model)" />
  <node name="robot_state_publisher" pkg="robot_state_publisher"
        type="robot_state_publisher"/>

  <!-- ─── 8. 导航 (AMCL + move_base) ─── -->
  <node name="map_server" pkg="map_server" type="map_server"
        args="$(find palletizing)/maps/warehouse.yaml"/>
  <include file="$(find wpb_home_tutorials)/nav_lidar/amcl_omni.launch" />
  <node pkg="move_base" type="move_base" respawn="false"
        name="move_base" output="screen">
    <rosparam file="$(find wpb_home_tutorials)/nav_lidar/costmap_common_params.yaml"
              command="load" ns="global_costmap" />
    <rosparam file="$(find wpb_home_tutorials)/nav_lidar/costmap_common_params.yaml"
              command="load" ns="local_costmap" />
    <rosparam file="$(find wpb_home_tutorials)/nav_lidar/global_costmap_params.yaml"
              command="load" />
    <rosparam file="$(find wpb_home_tutorials)/nav_lidar/local_costmap_params.yaml"
              command="load" />
    <rosparam file="$(find wpb_home_tutorials)/nav_lidar/local_planner_params.yaml"
              command="load" />
    <param name="base_global_planner" value="global_planner/GlobalPlanner" />
    <param name="base_local_planner" value="wpbh_local_planner/WpbhLocalPlanner" />
    <param name="controller_frequency" value="10" type="double"/>
  </node>

  <!-- ─── 9. RViz ───
  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find wpr_simulation)/rviz/map_tool.rviz" required="true" /> -->

</launch>
