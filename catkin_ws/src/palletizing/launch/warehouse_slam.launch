<launch>
  <!-- ══════════════════════════════════════════════════════════
       码垛机器人 - 仓库建图 (仅用一次)
       用法:
         终端1: roslaunch palletizing warehouse_slam.launch
         终端2: rosrun wpr_simulation keyboard_vel_ctrl
         终端3: rosrun map_server map_saver -f $(rospack find palletizing)/maps/warehouse
  ══════════════════════════════════════════════════════════ -->

  <!-- ─── Gazebo ─── -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find palletizing)/worlds/warehouse.world"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="debug" value="false"/>
  </include>

  <!-- ─── 机器人 + 桌子 (与 warehouse_sim 位置一致) ─── -->
  <node name="spawn_robot" pkg="gazebo_ros" type="spawn_model"
        args="-file $(find wpr_simulation)/models/wpb_home_mani.model
              -urdf -x 0 -y 0 -model wpb_home_mani" />
  <node name="table_a" pkg="gazebo_ros" type="spawn_model"
        args="-file $(find palletizing)/models/table.model
              -urdf -x 2.0 -y 1.75 -z 0 -Y 1.57 -model table_a" />
  <node name="table_b" pkg="gazebo_ros" type="spawn_model"
        args="-file $(find palletizing)/models/table.model
              -urdf -x -2.0 -y -1.75 -z 0 -Y 1.57 -model table_b" />
  <node name="table_c" pkg="gazebo_ros" type="spawn_model"
        args="-file $(find palletizing)/models/table.model
              -urdf -x 2.0 -y -1.75 -z 0 -Y 1.57 -model table_c" />

  <!-- ─── 控制器 + 激光雷达 ─── -->
  <include file="$(find wpr_simulation)/launch/wpb_home_controllers.launch"/>
  <node pkg="wpr_simulation" type="lidar_filter" name="lidar_filter" />

  <!-- ─── URDF ─── -->
  <arg name="model" default="$(find wpb_home_bringup)/urdf/wpb_home_mani.urdf"/>
  <param name="robot_description" command="$(find xacro)/xacro $(arg model)" />
  <node name="robot_state_publisher" pkg="robot_state_publisher"
        type="robot_state_publisher"/>

  <!-- ─── gmapping 建图 ─── -->
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <param name="base_frame" value="base_footprint"/>
    <param name="odom_frame" value="odom"/>
    <param name="map_frame" value="map"/>
    <param name="map_update_interval" value="1.0"/>
    <param name="maxUrange" value="5.5"/>
    <param name="maxRange" value="6.0"/>
    <param name="particles" value="30"/>
    <param name="delta" value="0.05"/>
  </node>

  <!-- ─── RViz ─── -->
  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find wpr_simulation)/rviz/slam.rviz" />
</launch>
