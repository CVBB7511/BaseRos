<launch>
  <!-- ══════════════════════════════════════════════════════════
       码垛机器人 - 实机仓库建图 (Real World SLAM)
       
       说明：
       此 launch 文件用于在真实环境中使用激光雷达和 gmapping 算法
       构建二维占用栅格地图。包含手柄遥控节点，无需手动开启键盘控制。
       
       用法:
         终端1: roslaunch palletizing warehouse_slam_real.launch
         终端2: 遥控机器人走遍全场后，执行：
                rosrun map_server map_saver -f $(rospack find palletizing)/maps/warehouse_real
  ══════════════════════════════════════════════════════════ -->

  <!-- ─── 启动真实机器人底盘、雷达与核心驱动 ─── -->
  <!-- normal.launch 仅包含底盘控制和 robot_state_publisher -->
  <include file="$(find wpb_home_bringup)/launch/normal.launch" />

  <!-- 补充 joint_state_publisher：发布静态关节(如机械臂)的默认角度为0，
       防止因缺少关节状态导致 TF 树断裂，使得激光雷达(laser)无法链接到底盘(base_footprint) -->
  <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" />

  <!-- ─── 启动激光雷达及滤波 ─── -->
  <node name="rplidarNode" pkg="rplidar_ros" type="rplidarNode" output="screen">
    <param name="serial_port" type="string" value="/dev/rplidar"/>  
    <param name="serial_baudrate" type="int" value="115200"/>
    <param name="frame_id" type="string" value="laser"/>
    <param name="inverted" type="bool" value="false"/>
    <param name="angle_compensate" type="bool" value="true"/>
    <remap from="scan" to="scan_raw"/>
  </node>
  <node pkg="wpb_home_bringup" type="wpb_home_lidar_filter" name="wpb_home_lidar_filter">
    <param name="pub_topic" value="/scan"/>
  </node>

  <!-- ─── gmapping 建图算法 ─── -->
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <param name="base_frame" value="base_footprint"/>
    <param name="odom_frame" value="odom"/>
    <param name="map_frame" value="map"/>
    
    <!-- 地图更新间隔，对于实机可以设长一点降低 CPU 负担 -->
    <param name="map_update_interval" value="1.0"/>
    <!-- 激光雷达可用距离与最大测量距离 (Rplidar A2 通常在 8m 左右) -->
    <param name="maxUrange" value="5.5"/>
    <param name="maxRange" value="8.0"/>
    
    <param name="particles" value="30"/>
    <!-- 地图分辨率：0.05m/pixel -->
    <param name="delta" value="0.05"/>
  </node>

</launch>
