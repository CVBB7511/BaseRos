<?xml version="1.0"?>
<robot name="large_table">
  <link name="table_link">
    <!-- 桌面 (2.4m x 1.0m x 0.05m) -->
    <visual>
      <origin xyz="0 0 0.74" rpy="0 0 0"/>
      <geometry><box size="2.4 1.0 0.05"/></geometry>
      <material name="wood"><color rgba="0.6 0.4 0.2 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.74" rpy="0 0 0"/>
      <geometry><box size="2.4 1.0 0.05"/></geometry>
    </collision>
    
    <!-- 桌腿 - 左前 -->
    <visual>
      <origin xyz="1.1 0.45 0.37" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.74"/></geometry>
    </visual>
    <!-- 桌腿 - 右前 -->
    <visual>
      <origin xyz="-1.1 0.45 0.37" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.74"/></geometry>
    </visual>
    <!-- 桌腿 - 左后 -->
    <visual>
      <origin xyz="1.1 -0.45 0.37" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.74"/></geometry>
    </visual>
    <!-- 桌腿 - 右后 -->
    <visual>
      <origin xyz="-1.1 -0.45 0.37" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.74"/></geometry>
    </visual>

    <inertial>
      <mass value="20.0"/>
      <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
    </inertial>
  </link>
  <gazebo reference="table_link">
    <material>Gazebo/Wood</material>
    <static>true</static>
  </gazebo>
</robot>
