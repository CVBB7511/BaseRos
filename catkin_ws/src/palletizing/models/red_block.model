<?xml version="1.0"?>
<robot name="red_block">

<link name="base_link">
  <visual>
    <geometry><box size="0.01 0.01 0.001" /></geometry>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </visual>
</link>

<link name="body_link">
  <visual>
    <geometry><box size="0.10 0.10 0.10"/></geometry>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </visual>
  <collision>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <geometry><box size="0.10 0.10 0.10"/></geometry>
  </collision>
  <inertial>
    <mass value="0.20"/>
    <inertia ixx="0.00033" ixy="0.0" ixz="0.0"
             iyy="0.00033" iyz="0.0" izz="0.00033"/>
  </inertial>
</link>

<joint name="base_to_body" type="fixed">
  <parent link="base_link"/>
  <child link="body_link"/>
  <origin rpy="0 0 0" xyz="0 0 0"/>
</joint>

<gazebo reference="body_link">
  <material>Gazebo/Red</material>
  <kp>500000.0</kp>
  <kd>100.0</kd>
  <mu1>100.0</mu1>
  <mu2>100.0</mu2>
  <maxVel>1.0</maxVel>
  <minDepth>0.001</minDepth>
</gazebo>

</robot>
