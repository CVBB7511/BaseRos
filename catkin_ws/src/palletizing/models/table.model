<?xml version="1.0"?>
<!-- 基于厂家 wpr_simulation/models/table.model 的修改版
     变更: 在桌腿之间添加了四面 collision-only 挡板 (无 visual)
     目的: 让 2D 激光雷达能扫描到桌子的完整轮廓, 避免导航时穿过桌下
     原始文件: wpr_simulation/models/table.model (未修改)
-->
<robot name="table">
<!-- base -->
<link name="base_link">
<visual>
  <geometry>
    <box size="0.01 0.01 0.001" />
  </geometry>
  <origin rpy = "0 0 0" xyz = "0 0 0"/>
</visual>
</link>

<!-- body (桌面) -->
<link name = "body_link">
  <visual>
    <geometry>
      <mesh filename="package://wpr_simulation/meshes/table.dae" scale="1 1 0.980392"/>
    </geometry>
    <origin rpy = "0 0 0" xyz = "-0.25 -0.6 -0.75"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0" />
    <geometry>
      <box size="0.50 1.20 0.03"/>
    </geometry>
  </collision>
  <inertial>
    <mass value="2"/>
    <inertia ixx="1.00538" ixy="0.0" ixz="0.0" iyy="1.00538" iyz="0.0" izz="0.11076"/>
  </inertial>
</link>
<joint name = "base_to_body" type = "fixed">
  <parent link = "base_link"/>
  <child link = "body_link"/>
  <origin rpy="0 0 0" xyz="0 0 0.75"/> <!--pos-->
</joint>

<!-- ═══ 原始桌腿 ═══ -->

<!-- leg: left-front -->
<link name = "lf_link">
  <collision>
    <origin xyz="0.235 -0.585 0.36" rpy="0 0 0" />
    <geometry>
      <box size="0.03 0.03 0.72"/>
    </geometry>
  </collision>
</link>
<joint name = "body_to_lf" type = "fixed">
  <parent link = "base_link"/>
  <child link = "lf_link"/>
  <origin rpy="0 0 0" xyz="0 0 0"/>
</joint>

<!-- leg: back-front -->
<link name = "bf_link">
  <collision>
    <origin xyz="-0.235 -0.585 0.36" rpy="0 0 0" />
    <geometry>
      <box size="0.03 0.03 0.72"/>
    </geometry>
  </collision>
</link>
<joint name = "body_to_bf" type = "fixed">
  <parent link = "base_link"/>
  <child link = "bf_link"/>
  <origin rpy="0 0 0" xyz="0 0 0"/>
</joint>

<!-- leg: left-rear -->
<link name = "lr_link">
  <collision>
    <origin xyz="0.235 0.585 0.36" rpy="0 0 0" />
    <geometry>
      <box size="0.03 0.03 0.72"/>
    </geometry>
  </collision>
</link>
<joint name = "body_to_lr" type = "fixed">
  <parent link = "base_link"/>
  <child link = "lr_link"/>
  <origin rpy="0 0 0" xyz="0 0 0"/>
</joint>

<!-- leg: back-rear -->
<link name = "br_link">
  <collision>
    <origin xyz="-0.235 0.585 0.36" rpy="0 0 0" />
    <geometry>
      <box size="0.03 0.03 0.72"/>
    </geometry>
  </collision>
</link>
<joint name = "body_to_br" type = "fixed">
  <parent link = "base_link"/>
  <child link = "br_link"/>
  <origin rpy="0 0 0" xyz="0 0 0"/>
</joint>

<!-- ═══ 新增: 桌腿之间的透明挡板 (collision-only, 无 visual) ═══
     目的: 让 2D 雷达能扫描到桌子的完整矩形轮廓
     挡板厚度 0.02m, 高度覆盖桌腿高度 (0.72m)

     桌腿坐标:
       lf = (+0.235, -0.585)
       bf = (-0.235, -0.585)
       lr = (+0.235, +0.585)
       br = (-0.235, +0.585)

     四面挡板:
       前面 (y=-0.585): lf—bf 连线, 沿 x 方向, 长 0.47m
       后面 (y=+0.585): lr—br 连线, 沿 x 方向, 长 0.47m
       左面 (x=+0.235): lf—lr 连线, 沿 y 方向, 长 1.17m
       右面 (x=-0.235): bf—br 连线, 沿 y 方向, 长 1.17m
-->

<!-- 前挡板: lf—bf (y=-0.585 侧) -->
<link name="panel_front">
  <collision>
    <origin xyz="0.0 -0.585 0.36" rpy="0 0 0"/>
    <geometry>
      <box size="0.47 0.02 0.72"/>
    </geometry>
  </collision>
</link>
<joint name="base_to_panel_front" type="fixed">
  <parent link="base_link"/>
  <child link="panel_front"/>
  <origin rpy="0 0 0" xyz="0 0 0"/>
</joint>

<!-- 后挡板: lr—br (y=+0.585 侧) -->
<link name="panel_back">
  <collision>
    <origin xyz="0.0 0.585 0.36" rpy="0 0 0"/>
    <geometry>
      <box size="0.47 0.02 0.72"/>
    </geometry>
  </collision>
</link>
<joint name="base_to_panel_back" type="fixed">
  <parent link="base_link"/>
  <child link="panel_back"/>
  <origin rpy="0 0 0" xyz="0 0 0"/>
</joint>

<!-- 左挡板: lf—lr (x=+0.235 侧) -->
<link name="panel_left">
  <collision>
    <origin xyz="0.235 0.0 0.36" rpy="0 0 0"/>
    <geometry>
      <box size="0.02 1.17 0.72"/>
    </geometry>
  </collision>
</link>
<joint name="base_to_panel_left" type="fixed">
  <parent link="base_link"/>
  <child link="panel_left"/>
  <origin rpy="0 0 0" xyz="0 0 0"/>
</joint>

<!-- 右挡板: bf—br (x=-0.235 侧) -->
<link name="panel_right">
  <collision>
    <origin xyz="-0.235 0.0 0.36" rpy="0 0 0"/>
    <geometry>
      <box size="0.02 1.17 0.72"/>
    </geometry>
  </collision>
</link>
<joint name="base_to_panel_right" type="fixed">
  <parent link="base_link"/>
  <child link="panel_right"/>
  <origin rpy="0 0 0" xyz="0 0 0"/>
</joint>

</robot>
