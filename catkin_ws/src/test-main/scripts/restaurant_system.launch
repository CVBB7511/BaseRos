<launch>

  <!--
    餐厅服务机器人系统总启动文件

    当前版本用于第15周测试结果评审前的系统链路测试。

    测试链路：
    voice_interaction_node
        ↓ /voice_cmd
    robot_controller
        ↓ /restaurant/task_name
    task_dispatcher
        ↓ /restaurant/nav_target
    navigation_manager
        ↓ mock_navigation 模拟到达
    task_dispatcher
        ↓ /restaurant/task_status
    robot_controller / voice_interaction_node

    包结构说明：
    1. restaurant_robot_core
       负责 robot_controller 与 task_dispatcher。
    2. restaurant_robot_navigation
       负责 navigation_manager。
    3. restaurant_voice_interaction
       负责语音交互与点餐。
    4. wpr_simulation / WPB-Home
       只作为底层仿真、地图、move_base 或真实机器人环境。
  -->

  <!-- ========== 全局测试参数 ========== -->

  <!--
    use_mock_navigation=true：
    不依赖真实机器人、不依赖 Gazebo、不依赖 move_base。
    navigation_manager 收到目标点后会模拟发布 ARRIVED。
  -->
  <arg name="use_mock_navigation" default="true" />

  <!--
    task_test_mode=true：
    task_dispatcher 不再强制等待 localization_ready，
    方便做语音-主控-调度-导航的话题级系统测试。
  -->
  <arg name="task_test_mode" default="true" />

  <arg name="default_table" default="table_1" />
  <arg name="default_customer_count" default="1" />
  <arg name="robot_name" default="robot_1" />

  <!-- ========== 1. 导航管理节点 ========== -->

  <node pkg="restaurant_robot_navigation"
        type="navigation_manager.py"
        name="navigation_manager"
        output="screen">

    <param name="package_name" value="restaurant_robot_navigation" />

    <!--
      配置文件仍统一放在项目 src/config 下。
      从 src/navigation 包目录出发，../config/restaurant_nav_points.yaml
      指向 src/config/restaurant_nav_points.yaml。
    -->
    <param name="config_rel_path" value="../config/restaurant_nav_points.yaml" />

    <!-- 测试评审阶段建议为 true -->
    <param name="mock_navigation" value="$(arg use_mock_navigation)" />
    <param name="mock_arrival_delay" value="1.0" />

    <!-- 真实/仿真机器人模式下才会使用 -->
    <param name="move_base_wait_timeout" value="10.0" />
    <param name="navigation_timeout" value="120.0" />
  </node>

  <!-- ========== 2. 任务调度节点 ========== -->

  <node pkg="restaurant_robot_core"
        type="task_dispatcher.py"
        name="task_dispatcher"
        output="screen">

    <param name="package_name" value="restaurant_robot_core" />

    <!--
      配置文件仍统一放在项目 src/config 下。
      从 src/core 包目录出发，../config/restaurant_nav_points.yaml
      指向 src/config/restaurant_nav_points.yaml。
    -->
    <param name="nav_points_rel_path" value="../config/restaurant_nav_points.yaml" />
    <param name="task_routes_rel_path" value="../config/restaurant_task_routes.yaml" />

    <!-- 测试评审阶段建议为 true -->
    <param name="test_mode" value="$(arg task_test_mode)" />

    <!-- 测试模式下不要求定位完成，不自动回 wait_area -->
    <param name="require_localization" value="false" />
    <param name="auto_home_enabled" value="false" />
  </node>

  <!-- ========== 3. 主控节点 ========== -->

  <node pkg="restaurant_robot_core"
        type="robot_controller.py"
        name="robot_controller"
        output="screen">

    <param name="robot_name" value="$(arg robot_name)" />
    <param name="default_table" value="$(arg default_table)" />
    <param name="default_customer_count" value="$(arg default_customer_count)" />
    <param name="auto_create_session" value="true" />

    <!-- 测试结果评审阶段建议保持为 true -->
    <param name="allow_task_without_db" value="true" />
    <param name="fallback_table_on_db_error" value="true" />
    <!-- 关键异常发生时，主控模块同步发布 /robot_state=EXCEPTION -->
    <param name="publish_exception_robot_state" value="true" />
  </node>

  <!-- ========== 4. 语音交互节点 ========== -->

  <include file="$(find restaurant_voice_interaction)/launch/voice_interaction.launch">
    <arg name="default_table" value="$(arg default_table)" />
    <arg name="auto_start_session" value="true" />
    <arg name="default_customer_count" value="$(arg default_customer_count)" />
    <arg name="allow_keyboard_input" value="true" />
  </include>

</launch>
