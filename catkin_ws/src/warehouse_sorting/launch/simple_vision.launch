<launch>
  <arg name="start_kinect" default="true"/>
  <arg name="kinect_fps_limit" default="5.0"/>
  <arg name="use_minimal_kinect" default="true"/>
  <arg name="use_nodelet" default="false"/>
  <arg name="rgb_topic" default="/kinect2/sd/image_color_rect"/>
  <arg name="depth_topic" default="/kinect2/sd/image_depth_rect"/>
  <arg name="camera_info_topic" default="/kinect2/sd/camera_info"/>
  <arg name="output_frame" default=""/>
  <arg name="process_hz" default="5.0"/>
  <arg name="min_area" default="800"/>
  <arg name="min_depth" default="0.15"/>
  <arg name="max_depth" default="2.0"/>
  <arg name="publish_debug_image" default="true"/>

  <include if="$(eval arg('start_kinect') == 'true' and arg('use_minimal_kinect') == 'true')"
           file="$(find warehouse_sorting)/launch/minimal_kinect2.launch">
    <arg name="fps_limit" value="$(arg kinect_fps_limit)"/>
    <arg name="use_nodelet" value="$(arg use_nodelet)"/>
  </include>

  <include if="$(eval arg('start_kinect') == 'true' and arg('use_minimal_kinect') != 'true')"
           file="$(find kinect2_bridge)/launch/kinect2_bridge.launch">
    <arg name="fps_limit" value="$(arg kinect_fps_limit)"/>
    <arg name="use_nodelet" value="$(arg use_nodelet)"/>
    <arg name="bilateral_filter" value="false"/>
    <arg name="edge_aware_filter" value="false"/>
    <arg name="worker_threads" value="2"/>
    <arg name="queue_size" value="2"/>
  </include>

  <node pkg="warehouse_sorting"
        type="simple_object_detector.py"
        name="simple_object_detector"
        output="screen">
    <param name="rgb_topic" value="$(arg rgb_topic)"/>
    <param name="depth_topic" value="$(arg depth_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="output_frame" value="$(arg output_frame)"/>
    <param name="process_hz" value="$(arg process_hz)"/>
    <param name="min_area" value="$(arg min_area)"/>
    <param name="min_depth" value="$(arg min_depth)"/>
    <param name="max_depth" value="$(arg max_depth)"/>
    <param name="publish_debug_image" value="$(arg publish_debug_image)"/>
    <rosparam param="roi">{x: 0.05, y: 0.05, width: 0.90, height: 0.90}</rosparam>
    <rosparam param="targets">
      - {name: natural, hsv_lower: [10, 20, 60], hsv_upper: [35, 180, 230]}
      - {name: colored, hsv_lower: [90, 60, 50], hsv_upper: [135, 255, 255]}
    </rosparam>
  </node>
</launch>
