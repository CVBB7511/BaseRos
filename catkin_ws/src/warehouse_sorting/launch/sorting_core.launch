<launch>
  <arg name="use_camera" default="false"/>
  <arg name="use_wpb_home_objects" default="false"/>
  <arg name="fallback_to_mock" default="true"/>
  <arg name="rgb_topic" default="/camera/rgb/image_raw"/>
  <arg name="depth_topic" default="/camera/depth/image_raw"/>
  <arg name="camera_info_topic" default="/camera/rgb/camera_info"/>
  <arg name="camera_on_demand" default="true"/>
  <arg name="camera_warmup_timeout" default="2.5"/>
  <arg name="camera_require_depth" default="false"/>
  <arg name="camera_require_info" default="false"/>
  <arg name="dry_run_arm" default="true"/>
  <arg name="publish_wpb_home_topics" default="false"/>
  <arg name="tabletop_only" default="true"/>
  <arg name="use_wpb_home_actions" default="false"/>
  <arg name="wait_for_wpb_home_result" default="false"/>
  <arg name="dry_run_navigation" default="true"/>
  <arg name="source_zone_id" default="source_a"/>
  <arg name="default_total_items" default="4"/>
  <arg name="max_retries" default="3"/>
  <arg name="wpb_home_detection_timeout" default="5.0"/>
  <arg name="color_depth_enabled" default="true"/>

  <rosparam file="$(find warehouse_sorting)/config/sorting.yaml" command="load"/>

  <node pkg="warehouse_sorting" type="vision_node.py" name="vision_node" output="screen">
    <param name="use_camera" value="$(arg use_camera)"/>
    <param name="use_wpb_home_objects" value="$(arg use_wpb_home_objects)"/>
    <param name="fallback_to_mock" value="$(arg fallback_to_mock)"/>
    <param name="rgb_topic" value="$(arg rgb_topic)"/>
    <param name="depth_topic" value="$(arg depth_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="camera_on_demand" value="$(arg camera_on_demand)"/>
    <param name="camera_warmup_timeout" value="$(arg camera_warmup_timeout)"/>
    <param name="camera_require_depth" value="$(arg camera_require_depth)"/>
    <param name="camera_require_info" value="$(arg camera_require_info)"/>
    <param name="wpb_home_detection_timeout" value="$(arg wpb_home_detection_timeout)"/>
    <param name="color_depth_enabled" value="$(arg color_depth_enabled)"/>
    <param name="frame_id" value="base_link"/>
  </node>

  <node pkg="warehouse_sorting" type="arm_control_node.py" name="arm_control" output="screen">
    <param name="dry_run" value="$(arg dry_run_arm)"/>
    <param name="publish_wpb_home_topics" value="$(arg publish_wpb_home_topics)"/>
    <param name="tabletop_only" value="$(arg tabletop_only)"/>
    <param name="use_wpb_home_actions" value="$(arg use_wpb_home_actions)"/>
    <param name="wait_for_wpb_home_result" value="$(arg wait_for_wpb_home_result)"/>
  </node>

  <node pkg="warehouse_sorting" type="task_manager_node.py" name="task_manager" output="screen">
    <param name="dry_run_navigation" value="$(arg dry_run_navigation)"/>
    <param name="source_zone_id" value="$(arg source_zone_id)"/>
    <param name="default_total_items" value="$(arg default_total_items)"/>
    <param name="max_retries" value="$(arg max_retries)"/>
  </node>
</launch>
